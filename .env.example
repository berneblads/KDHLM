# SERVER ONLY. Never prefix secrets with VITE_. Copy to .env.local for vercel dev.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_DRIVE_ID=
MS_ITEM_ID=
MS_SHEET_NAME=Kalender
# Persistent REST Redis, e.g. an existing Upstash database. Required for live calendar.
CACHE_REST_URL=
CACHE_REST_TOKEN=
# No guessed local Page ID or Graph version. Set after validating current Meta access.
META_PAGE_ID=
META_PAGE_NAME=
META_PAGE_URL=
META_PAGE_ACCESS_TOKEN=
META_API_VERSION=

# Contact form: server only. Sender must belong to a verified Resend domain.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
